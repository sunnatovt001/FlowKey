DATABASE_URL="postgresql://flowza:flowza_local_only@localhost:5432/flowza?schema=public"
APP_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_ENCRYPTION_KEY=""
BETTER_AUTH_SECRET=""
# OAuth sign-in (configure both values for each provider to enable its button).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Local development only: verification/reset emails are written to ignored local-data/mail.
MAIL_TRANSPORT="file"
# Production must use SMTP, never file delivery.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""

# Local Telegram support assistant (no Sites deployment)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_ADMIN_CHAT_ID=""
SUPPORT_AI_API_KEY=""
SUPPORT_AI_MODEL="gpt-4.1-mini"
# Platform admin: comma-separated verified user IDs. Empty denies all access.
FLOWKEY_ADMIN_USER_IDS=""
FLOWKEY_ADMIN_EMAIL=""
FLOWKEY_ADMIN_PASSWORD_HASH=""
FLOWKEY_ADMIN_SESSION_SECRET=""
