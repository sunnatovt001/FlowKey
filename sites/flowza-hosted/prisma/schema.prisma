generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url = "file:./local.db"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  telegramConnection TelegramConnection?
  telegramLink TelegramLink?
  supportTickets SupportTicket[]
  sessions     Session[]
  businesses   Business[]
  memberships  Membership[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
}

model Business {
  id        String    @id @default(cuid())
  ownerId   String    @unique
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  type      String
  country   String    @default("Uzbekistan")
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id           String            @id @default(cuid())
  businessId   String
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  website      String?
  description  String?
  archivedAt DateTime?
  createdAt    DateTime          @default(now())
  memberships  Membership[]
  keys         ApiKey[]
  transactions Transaction[]
  endpoints    WebhookEndpoint[]
  audits       AuditLog[]
  paymentLinks PaymentLink[]
  checkoutSessions CheckoutSession[]
}

model PaymentLink {
  id String @id
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  title String
  amountMinor Int
  currency String @default("UZS")
  createdAt DateTime @default(now())
  disabledAt DateTime?
  sessions CheckoutSession[]
  @@index([projectId, createdAt])
}
model CheckoutSession {
  id String @id
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  linkId String?
  link PaymentLink? @relation(fields: [linkId], references: [id], onDelete: Restrict)
  title String
  amountMinor Int
  currency String @default("UZS")
  requestKey String
  requestHash String
  result String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@unique([projectId, requestKey])
  @@index([projectId, createdAt])
}

model Membership {
  userId    String
  projectId String
  role      String  @default("owner")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

model ApiKey {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  secretHash String    @unique
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([projectId])
}

model Transaction {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amountMinor    Int
  currency       String            @default("UZS")
  status         String
  idempotencyKey String
  requestHash    String
  createdAt      DateTime          @default(now())
  deliveries     WebhookDelivery[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, createdAt])
  @@index([projectId, status])
}

model WebhookEndpoint {
  id              String            @id @default(cuid())
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url             String
  events Json
  secretEncrypted String
  createdAt       DateTime          @default(now())
  disabledAt      DateTime?
  deliveries      WebhookDelivery[]

  @@index([projectId])
}

model WebhookDelivery {
  id            String          @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  event         String
  attempts      Int             @default(0)
  status        String          @default("queued")
  responseCode  Int?
  error         String?
  lastAttemptAt DateTime?
  createdAt     DateTime        @default(now())

  @@unique([endpointId, transactionId])
}

model AuditLog {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action     String
  resourceId String
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}

model RateLimit {
  key      String   @id
  count    Int      @default(1)
  resetsAt DateTime
}

model TelegramConnection {
  id       String @id @default(cuid())
  userId   String @unique
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId   String @unique
  linkedAt DateTime @default(now())
  messages TelegramMessage[]
}
model TelegramLink {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String @unique
  expiresAt DateTime
}
model TelegramMessage {
  id String @id @default(cuid())
  connectionId String
  connection TelegramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalId String
  role String
  content String
  createdAt DateTime @default(now())
  @@unique([connectionId, externalId])
  @@index([connectionId, createdAt])
}
model SupportTicket {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestKey String @unique
  summary String
  diagnostics Json
  status String @default("queued")
  attempts Int @default(0)
  retryAt DateTime @default(now())
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, retryAt])
  @@index([userId, createdAt])
}
model SupportBotState {
  id String @id
  offset Int @default(0)
  leaseOwner String?
  leaseUntil DateTime?
}

