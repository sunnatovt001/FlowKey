generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  passwordHash  String           @default("")
  name          String           @default("")
  emailVerified Boolean          @default(false)
  telegramConnection TelegramConnection?
  telegramLink TelegramLink?
  supportTickets SupportTicket[]
  image         String?
  updatedAt     DateTime         @updatedAt
  accounts      Account[]
  draft         OnboardingDraft?
  createdAt     DateTime         @default(now())
  sessions      Session[]
  businesses    Business[]
  memberships   Membership[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String?  @unique
  token     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
}

model Business {
  id        String    @id @default(cuid())
  ownerId   String    @unique
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  type      String
  country   String    @default("Uzbekistan")
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id           String            @id @default(cuid())
  businessId   String
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  website      String?
  description  String?
  createdAt    DateTime          @default(now())
  archivedAt   DateTime?
  memberships  Membership[]
  keys         ApiKey[]
  transactions Transaction[]
  endpoints    WebhookEndpoint[]
  audits       AuditLog[]
  paymentLinks PaymentLink[]
  checkoutSessions CheckoutSession[]
  ledgerEntries LedgerEntry[]
  refunds Refund[]
  payouts Payout[]
  subscriptions Subscription[]
  invites ProjectInvite[]
}

model PaymentLink {
  id String @id
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  title String
  amountMinor BigInt
  currency String @default("UZS")
  createdAt DateTime @default(now())
  disabledAt DateTime?
  sessions CheckoutSession[]
  @@index([projectId, createdAt])
}

model CheckoutSession {
  id String @id
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  linkId String?
  link PaymentLink? @relation(fields: [linkId], references: [id], onDelete: Restrict)
  title String
  amountMinor BigInt
  currency String @default("UZS")
  requestKey String
  requestHash String
  result String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@unique([projectId, requestKey])
  @@index([projectId, createdAt])
}

model Membership {
  userId    String
  projectId String
  role      String  @default("owner")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

model ApiKey {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  secretHash String    @unique
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([projectId])
}

model Transaction {
  id                String            @id @default(cuid())
  projectId         String
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amountMinor       BigInt
  currency          String            @default("UZS")
  status            String
  idempotencyKey    String
  requestHash       String
  provider          String            @default("sandbox")
  providerReference String?
  createdAt         DateTime          @default(now())
  deliveries        WebhookDelivery[]
  paymentEvent      PaymentEvent?
  refunds Refund[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, createdAt])
  @@index([projectId, status])
}

model WebhookEndpoint {
  id              String            @id @default(cuid())
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url             String
  events          String[]
  secretEncrypted String
  createdAt       DateTime          @default(now())
  disabledAt      DateTime?
  deliveries      WebhookDelivery[]

  @@index([projectId])
}

model WebhookDelivery {
  id            String                   @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint          @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction              @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  event         String
  attempts      Int                      @default(0)
  status        String                   @default("queued")
  responseCode  Int?
  error         String?
  lastAttemptAt DateTime?
  nextAttemptAt DateTime                 @default(now())
  leaseUntil    DateTime?
  payload       String?
  eventId       String?
  eventRecord   PaymentEvent?            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  history       WebhookDeliveryAttempt[]
  createdAt     DateTime                 @default(now())

  @@unique([endpointId, transactionId])
  @@index([status, nextAttemptAt])
}

model PaymentEvent {
  id            String            @id
  transactionId String            @unique
  transaction   Transaction       @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  type          String
  payload       String
  createdAt     DateTime          @default(now())
  deliveries    WebhookDelivery[]
}

model AuditLog {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action     String
  resourceId String
  actorId    String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}

model RateLimit {
  key      String   @id
  count    Int      @default(1)
  resetsAt DateTime
}

model AuthRateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model OnboardingDraft {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  values    Json
  updatedAt DateTime @updatedAt
}

model WebhookDeliveryAttempt {
  id            String          @id @default(cuid())
  deliveryId    String
  delivery      WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  attemptNumber Int
  responseCode  Int?
  error         String?
  startedAt     DateTime        @default(now())
  completedAt   DateTime?

  @@unique([deliveryId, attemptNumber])
}

model TelegramConnection {
  id       String @id @default(cuid())
  userId   String @unique
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId   String @unique
  linkedAt DateTime @default(now())
  messages TelegramMessage[]
}
model TelegramLink {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String @unique
  expiresAt DateTime
}
model TelegramMessage {
  id String @id @default(cuid())
  connectionId String
  connection TelegramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalId String
  role String
  content String
  createdAt DateTime @default(now())
  @@unique([connectionId, externalId])
  @@index([connectionId, createdAt])
}
model SupportTicket {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestKey String @unique
  summary String
  diagnostics Json
  status String @default("queued")
  attempts Int @default(0)
  retryAt DateTime @default(now())
  deliveredAt DateTime?
  resolutionStatus String @default("open")
  resolvedAt DateTime?
  resolvedBy String?
  createdAt DateTime @default(now())
  @@index([status, retryAt])
  @@index([userId, createdAt])
  @@index([resolutionStatus, createdAt])
}
model AdminAudit {
  id String @id @default(cuid())
  actorId String
  action String
  targetId String
  details Json
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model SupportBotState {
  id String @id
  offset Int @default(0)
  leaseOwner String?
  leaseUntil DateTime?
}

model LedgerEntry {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  operationId String
  account String
  currency String
  amountMinor BigInt
  createdAt DateTime @default(now())
  @@unique([operationId, account])
  @@index([projectId, currency, createdAt])
}

model Refund {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  paymentId String
  payment Transaction @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestKey String
  amountMinor BigInt
  feeMinor BigInt
  actorId String
  createdAt DateTime @default(now())
  @@unique([projectId, requestKey])
  @@index([paymentId])
}

model Payout {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requestKey String
  amountMinor BigInt
  currency String @default("UZS")
  status String @default("requested")
  actorId String
  approvedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([projectId, requestKey])
  @@index([projectId, createdAt])
}

model Subscription {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requestKey String
  title String
  amountMinor BigInt
  currency String @default("UZS")
  interval String
  status String @default("active")
  consentAt DateTime
  nextBillingAt DateTime
  period Int @default(0)
  createdAt DateTime @default(now())
  @@unique([projectId, requestKey])
  @@index([projectId, createdAt])
}

model ProjectInvite {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email String
  role String
  status String @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([projectId, email])
  @@index([email, status])
}

