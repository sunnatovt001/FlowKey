{
  "date": "2026-11-15",
  "status": "Installed and verified on production",
  "production": "https://flowkey.uz",
  "backup": {
    "intervalHours": 6,
    "retentionDays": 14,
    "location": "/home/deploy/flowkey-ops/backups",
