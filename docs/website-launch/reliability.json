  "verification": {
    "nodeSyntax": "passed",
    "eslint": "passed",
    "incidentUnitTest": "passed",
    "backupRestore": "passed",
    "rollbackRehearsal": "passed",
    "productionHealth": "ok"
  },
  "limitations": [
    "Backups are on the same server; offsite encrypted storage remains to be configured",
